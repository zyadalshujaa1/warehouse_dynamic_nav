<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    

    <material name="Blue_body">
        <color rgba="0.39 0.58 0.93 1"/>
    </material>

    <material name="Grey_body">
        <color rgba="0.3 0.3 0.3 1"/>
    </material>

    <material name="Blue_tech">
        <color rgba="0.2 0.4 1 1"/>
    </material>

    <material name="Black_wheels">
        <color rgba="0.05 0.05 0.05 1"/>
    </material>

    <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
    </material>

    <material name="Orange_body">
        <color rgba="1.0 0.45 0.0 1.0"/>
    </material>

    <xacro:macro name="box_inertia" params="m l h w xyz rpy">
        <inertial>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <mass value="${m}"/>
            <inertia ixx="${(m/12) * (w*w + h*h)}" ixy="0.0" ixz="0.0" 
                     iyy="${(m/12) * (l*l + h*h)}" iyz="0.0"
                     izz="${(m/12) * (l*l + w*w)}"/>    
    </inertial>
    </xacro:macro>


    <xacro:macro name="cylinder_inertia" params="m l r xyz rpy">
        <inertial>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <mass value="${m}"/>
            <inertia ixx="${(m/12) * (3*r*r + l*l)}" ixy="0.0" ixz="0.0"
                     iyy="${(m/12) * (3*r*r + l*l)}" iyz="0.0"
                     izz="${(m/2)  * (r*r)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertial" params="m r xyz rpy">
        <inertial>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <mass value="${m}"/>
            <inertia ixx="${(2.0/5.0) * (m*r*r)}" ixy="0.0" ixz="0.0"
                     iyy="${(2.0/5.0) * (m*r*r)}" iyz="0.0"   
                     izz="${(2.0/5.0) * (m*r*r)}"/>
        </inertial>
        
    </xacro:macro>

    
</robot>