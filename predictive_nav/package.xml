<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>predictive_nav</name>
  <version>0.3.0</version>
  <description>Navigation with predicted motion of dynamic obstacles: MPPI configurations and a prediction-aware MPPI critic</description>
  <maintainer email="zyadalshujaa@gmail.com">Zyad</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_core</depend>
  <depend>pluginlib</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>xtensor</depend>
  <depend>xsimd</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_mppi_controller plugin="${prefix}/predictive_critics.xml"/>
  </export>
</package>
